{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "declaration": true,
    "skipLibCheck": true,
  },
  "include": [],
  "exclude": ["node_modules"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
