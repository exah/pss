{
  "name": "pss-react",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "PSS primitives for React",
  "main": "out/index.js",
  "type": "module",
  "files": [
    "out",
    "ref"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && babel --extensions .ts,.tsx src --out-dir out",
    "test": "vitest run --config ../../vite.config.ts --root src",
    "size": "size-limit",
    "release": "np",
    "preversion": "npm run build",
    "prebuild": "rm -rf out"
  },
  "keywords": [],
  "author": "John Grishin <hi@johngrish.in>",
  "license": "MIT",
  "size-limit": [
    {
      "path": "./out/index.js",
      "limit": "6 KB"
    }
  ],
  "dependencies": {
    "pss": "^6.0.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
