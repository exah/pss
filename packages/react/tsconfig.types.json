{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "./types",
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": ["./src"],
  "exclude": ["./src/**/*.test.ts", "./src/**/*.test.tsx", "./src/__tests__"]
}
