{
  "name": "pss-project",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/core",
    "packages/react"
  ],
  "scripts": {
    "build": "npm -w pss-react run build",
    "test": "vitest run --typecheck",
    "typecheck": "tsc -p packages/react/tsconfig.json",
    "pack:dry-run": "npm -w pss pack --dry-run && npm -w pss-react pack --dry-run",
    "test:consumer": "node tests/consumer/verify.mjs"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "semi": false,
    "trailingComma": "es5",
    "printWidth": 80
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@size-limit/preset-small-lib": "^5.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^5.0.1",
    "typescript": "^6.0.0",
    "happy-dom": "^20.8.4",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
